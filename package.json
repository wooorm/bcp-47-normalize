{
  "author": "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
  "bugs": "https://github.com/wooorm/bcp-47-normalize/issues",
  "contributors": [
    "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)"
  ],
  "dependencies": {
    "bcp-47": "^2.0.0",
    "bcp-47-match": "^2.0.0"
  },
  "description": "Normalize, canonicalize, and format BCP 47 tags",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/xast": "^2.0.0",
    "c8": "^12.0.0",
    "cldr-core": "^49.0.0",
    "prettier": "^3.0.0",
    "remark-cli": "^12.0.0",
    "remark-preset-wooorm": "^11.0.0",
    "type-coverage": "^2.0.0",
    "typescript": "^6.0.0",
    "unist-util-visit": "^5.0.0",
    "xast-util-from-xml": "^4.0.0",
    "xo": "^5.0.0"
  },
  "files": [
    "lib/",
    "index.d.ts.map",
    "index.d.ts",
    "index.js"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wooorm"
  },
  "keywords": [
    "47",
    "bcp-47",
    "bcp47",
    "bcp",
    "canonical",
    "format",
    "language",
    "normal",
    "pretty",
    "region",
    "script",
    "subtag",
    "tag"
  ],
  "license": "MIT",
  "main": "./index.js",
  "name": "bcp-47-normalize",
  "prettier": {
    "bracketSpacing": false,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-wooorm"
    ]
  },
  "repository": "wooorm/bcp-47-normalize",
  "scripts": {
    "build": "tsc --build --clean && tsc --build && type-coverage",
    "format": "remark --frail --output --quiet -- . && prettier --log-level warn --write -- . && xo --fix",
    "generate": "node --conditions development build.js",
    "prepack": "npm run generate && npm run build && npm run format",
    "test-api": "node --conditions development test.js",
    "test-coverage": "c8 --100 --reporter lcov -- npm run test-api",
    "test": "npm run generate && npm run build && npm run format && npm run test-coverage"
  },
  "sideEffects": false,
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "./index.d.ts",
  "type": "module",
  "version": "2.4.0"
}
